{ pkgs }:
let
  lib = pkgs.lib;
  willow = import ../modules/profiles/programs/mihomo/willow.nix;

  # Nix cannot decrypt SOPS during a pure build. The caller supplies both
  # passwords from the secrets files via --impure:
  #   WILLOW_SS_PASSWORD=... WILLOW_HY2_PASSWORD=... \
  #     nix build --impure .#clash-verge-willow
  # Placeholders keep `nix flake check` (pure) evaluable.
  password =
    name: fallback:
    let
      value = builtins.getEnv name;
    in
    if value == "" then fallback else value;

  hy2Proxy = {
    name = willow.hy2Name;
    type = "hysteria2";
    server = willow.server;
    port = willow.hy2Port;
    password = password "WILLOW_HY2_PASSWORD" "<WILLOW_HY2_PASSWORD>";
    sni = willow.hy2Sni;
    fingerprint = willow.hy2Fingerprint;
    alpn = [ "h3" ];
    up = willow.hy2Up;
    down = willow.hy2Down;
  };

  ssProxy = {
    name = willow.ssName;
    type = "ss";
    server = willow.server;
    port = willow.ssPort;
    cipher = willow.ssCipher;
    password = password "WILLOW_SS_PASSWORD" "<WILLOW_SS_PASSWORD>";
    udp = willow.ssUdp;
    smux = {
      enabled = willow.ssSmux.enabled;
      protocol = willow.ssSmux.protocol;
      max-connections = willow.ssSmux.maxConnections;
      padding = willow.ssSmux.padding;
      only-tcp = willow.ssSmux.onlyTcp;
    };
  };

  # The Script variant can enumerate the subscription's proxies, so it
  # inserts a Willow-Entry selector and chains both transports through it.
  # Full/Merge cannot know those names; their proxies dial Willow directly.
  hy2Chained = hy2Proxy // {
    "dialer-proxy" = "Willow-Entry";
  };
  ssChained = ssProxy // {
    "dialer-proxy" = "Willow-Entry";
  };

  willowAuto = {
    name = "${willow.name}-Auto";
    type = "fallback";
    url = "https://www.gstatic.com/generate_204";
    interval = 300;
    proxies = [
      willow.hy2Name
      willow.ssName
    ];
  };

  willowSelect = {
    name = willow.name;
    type = "select";
    proxies = [
      "${willow.name}-Auto"
      willow.hy2Name
      willow.ssName
    ];
  };

  chainGroup = {
    name = "Chain";
    type = "select";
    proxies = [
      willow.name
      "DIRECT"
    ];
  };

  ruleLines = willow.openaiRules willow.name;

  yaml = lib.generators.toYAML { };
  indent =
    prefix: text:
    lib.concatMapStringsSep "\n" (line: "${prefix}${line}") (
      lib.splitString "\n" (lib.removeSuffix "\n" text)
    );

  proxiesYaml = indent "  " (yaml [
    hy2Proxy
    ssProxy
  ]);
  groupsYaml = indent "  " (yaml [
    willowSelect
    willowAuto
    chainGroup
  ]);
  mergeGroupsYaml = indent "  " (yaml [
    willowSelect
    willowAuto
  ]);
  rulesYaml = indent "  " (yaml ruleLines);

  full = ''
    # Generated by the NixOS repository. Contains the Willow HY2 and SS passwords.
    mixed-port: 7897
    allow-lan: false
    mode: rule
    log-level: info
    ipv6: false
    unified-delay: true
    tcp-concurrent: true

    profile:
      store-selected: true
      store-fake-ip: true

    dns:
      enable: true
      ipv6: false
      enhanced-mode: fake-ip
      fake-ip-range: 198.18.0.1/16
      respect-rules: true
      default-nameserver:
        - 223.5.5.5
        - 119.29.29.29
      nameserver:
        - https://1.1.1.1/dns-query
        - https://dns.google/dns-query
      proxy-server-nameserver:
        - https://1.1.1.1/dns-query
      nameserver-policy:
        "+.openai.com": [https://1.1.1.1/dns-query]
        "+.chatgpt.com": [https://1.1.1.1/dns-query]
        "+.oaistatic.com": [https://1.1.1.1/dns-query]
        "+.oaiusercontent.com": [https://1.1.1.1/dns-query]
        "+.oaistatsig.com": [https://1.1.1.1/dns-query]
        "+.intercom.io": [https://1.1.1.1/dns-query]
        "+.intercomcdn.com": [https://1.1.1.1/dns-query]
        "+.ct.sendgrid.net": [https://1.1.1.1/dns-query]
      fake-ip-filter:
        - "*.lan"
        - "*.local"
        - localhost
        - "time.*"
        - "stun.*"

    tun:
      enable: true
      stack: system
      auto-route: true
      auto-detect-interface: true
      dns-hijack:
        - any:53

    proxies:
    ${proxiesYaml}

    proxy-groups:
    ${groupsYaml}

    rules:
      - DOMAIN-SUFFIX,lan,DIRECT
      - DOMAIN-SUFFIX,local,DIRECT
      - IP-CIDR,127.0.0.0/8,DIRECT,no-resolve
      - IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
      - IP-CIDR,172.16.0.0/12,DIRECT,no-resolve
      - IP-CIDR,192.168.0.0/16,DIRECT,no-resolve
      - IP-CIDR,100.64.0.0/10,DIRECT,no-resolve
      - IP-CIDR6,::1/128,DIRECT,no-resolve
      - IP-CIDR6,fc00::/7,DIRECT,no-resolve
      - IP-CIDR6,fe80::/10,DIRECT,no-resolve
      - MATCH,Chain
  '';

  merge = ''
    # Generated by the NixOS repository. Contains the Willow HY2 and SS passwords.
    # Merge cannot enumerate subscription nodes, so these proxies dial Willow
    # directly and there is no Willow-Entry group. Use the Script variant if
    # you need entry + transport selection.
    prepend-proxies:
    ${proxiesYaml}

    prepend-proxy-groups:
    ${mergeGroupsYaml}

    prepend-rules:
    ${rulesYaml}
  '';

  script = ''
    // Generated by the NixOS repository. Contains the Willow HY2 and SS passwords.
    function main(config) {
      // Never fall back to DIRECT: without a discoverable entry node the
      // AI rules fail closed instead of bypassing the entry.
      const entryNames = (config.proxies || [])
        .map((proxy) => proxy.name)
        .filter((name) =>
          name !== ${builtins.toJSON willow.hy2Name} &&
          name !== ${builtins.toJSON willow.ssName} &&
          name !== "DIRECT" &&
          name !== "REJECT");
      const entries = entryNames.length > 0 ? entryNames : ["REJECT"];
      const proxies = ${
        builtins.toJSON [
          hy2Chained
          ssChained
        ]
      };
      const groups = [
        { name: "Willow-Entry", type: "select", proxies: entries },
        ...${
          builtins.toJSON [
            willowSelect
            willowAuto
          ]
        },
      ];
      const rules = ${builtins.toJSON ruleLines};
      config.proxies = [...proxies, ...(config.proxies || [])];
      config["proxy-groups"] = [...groups, ...(config["proxy-groups"] || [])];
      config.rules = [...rules, ...(config.rules || [])];
      return config;
    }
  '';
in
pkgs.runCommand "clash-verge-willow" { } ''
  mkdir -p $out
  cp ${pkgs.writeText "willow.yaml" full} $out/willow.yaml
  cp ${pkgs.writeText "willow-merge.yaml" merge} $out/willow-merge.yaml
  cp ${pkgs.writeText "willow-script.js" script} $out/willow-script.js
  cp ${../docs/clients/clash-verge/README.md} $out/README.md
''
