input {
    keyboard {
        xkb {
            layout "us"
        }
    }

    touchpad {
        tap
        dwt
        natural-scroll
    }

    // Keep the existing logind policy: a short power-button press is ignored.
    disable-power-key-handling
    focus-follows-mouse max-scroll-amount="0%"
}

// Writable output configuration maintained by nwg-displays.
include "monitor.kdl"

layout {
    gaps 8
    center-focused-column "on-overflow"

    // Keep the window-to-bar gap tighter without changing inner or side gaps.
    struts {
        top -4
    }

    preset-column-widths {
        proportion 0.5
        proportion 0.7
        proportion 0.85
    }

    default-column-width { proportion 0.7; }

    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    focus-ring {
        width 3
        active-color "#f5c2e7"
        inactive-color "#6c7086"
    }

    border { off; }

    shadow {
        on
        softness 24
        spread 3
        offset x=0 y=4
        color "#0007"
    }
}

// Keep window and workspace transitions quick while preserving touchpad motion.
animations {
    workspace-switch {
        spring damping-ratio=1.0 stiffness=1200 epsilon=0.0001
    }

    window-open {
        duration-ms 150
        curve "ease-out-expo"
    }

    window-close {
        duration-ms 150
        curve "ease-out-quad"
    }

    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    overview-open-close {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }
}

environment {
    QT_QPA_PLATFORM "wayland;xcb"
    QT_IM_MODULE "fcitx"
}

cursor {
    xcursor-theme "Bibata-Modern-Amber"
    xcursor-size 32
}

xwayland-satellite {
    path "@xwaylandSatellite@"
}

hotkey-overlay {
    skip-at-startup
    hide-not-bound
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
prefer-no-csd

@quickshellStartup@
@waybarStartup@
@wpaperdStartup@
// Fcitx5 starts through its XDG autostart entry.
spawn-at-startup "@wlPaste@" "--type" "text" "--watch" "@cliphist@" "store"
spawn-at-startup "@wlPaste@" "--type" "image" "--watch" "@cliphist@" "store"

window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}

window-rule {
    match app-id=r#"^FG$"#
    open-floating true
    default-column-width { proportion 0.7; }
    default-window-height { proportion 0.7; }
}

window-rule {
    match app-id=r#"^RTG$"#
    open-floating true
    default-column-width { proportion 0.6; }
    default-window-height { proportion 0.7; }
    default-floating-position x=0 y=0 relative-to="top-right"
}

window-rule {
    match app-id=r#"^AlohaLauncher$"#
    open-floating true
    default-column-width { proportion 0.7; }
    default-window-height { proportion 0.6; }
}

window-rule {
    match app-id=r#"(?i)^thunar$"#
    open-floating true
    default-column-width { proportion 0.7; }
    default-window-height { proportion 0.7; }
}

window-rule {
    match app-id=r#"(?i)^(firefox|zen-beta|app\.zen_browser\.zen)$"# title=r#"^Picture-in-Picture$"#
    open-floating true
    default-column-width { proportion 0.35; }
    default-window-height { proportion 0.35; }
    default-floating-position x=16 y=16 relative-to="bottom-right"
}

// Keep common password-manager windows out of xdg-desktop-portal screencasts.
window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#
    block-out-from "screencast"
}

// Keep notification pop-ups and the notification center out of xdg-desktop-portal screencasts.
layer-rule {
    match namespace=r#"^(notifications|swaync-notification-window|swaync-control-center)$"#
    block-out-from "screencast"
}

// Mod+Tab opens the recent-window switcher; holding Mod keeps cycling it.
recent-windows {
    binds {
        Mod+Tab         { next-window; }
        Mod+Shift+Tab   { previous-window; }
        Mod+grave       { next-window filter="app-id"; }
        Mod+Shift+grave { previous-window filter="app-id"; }
    }
}

binds {
    @quickshellToggle@
    Mod+Shift+Slash repeat=false { show-hotkey-overlay; }
    Mod+Ctrl+Shift+M repeat=false hotkey-overlay-title="Quit Niri" { quit; }
    Mod+M repeat=false hotkey-overlay-title="Suspend and Hibernate" { spawn "@systemctl@" "suspend-then-hibernate"; }
    Mod+Shift+M repeat=false hotkey-overlay-title="Hibernate" { spawn "@systemctl@" "hibernate"; }
    Mod+Ctrl+M repeat=false hotkey-overlay-title="Lock Session" { spawn "@loginctl@" "lock-session"; }

    Mod+R repeat=false hotkey-overlay-title="Open Applications" { spawn "aloha" "--root" "apps"; }
    Mod+P repeat=false hotkey-overlay-title="Open Commands" { spawn "aloha" "--root" "commands"; }
    Mod+Shift+P repeat=false hotkey-overlay-title="Open Power Menu" { spawn "aloha" "--root" "power"; }

    Mod+Return repeat=false hotkey-overlay-title="Open Terminal" { spawn "@kitty@"; }
    Mod+Space repeat=false hotkey-overlay-title="Open Floating Terminal" { spawn "@kitty@" "--class" "FG"; }
    Mod+E repeat=false hotkey-overlay-title="Open File Manager" { spawn "@thunar@"; }
    Mod+Ctrl+D repeat=false hotkey-overlay-title="Configure Displays" { spawn "@nwgDisplays@"; }

    Mod+Shift+Q repeat=false hotkey-overlay-title="Close Window" { close-window; }
    Mod+Ctrl+Shift+Q repeat=false hotkey-overlay-title="Force Kill Window" { spawn "@forceKill@"; }
    Mod+T repeat=false hotkey-overlay-title="Toggle Floating" { toggle-window-floating; }
    Mod+Shift+T repeat=false hotkey-overlay-title="Resize and Center Window" { spawn "@resizeAndCenter@"; }
    Mod+F repeat=false hotkey-overlay-title="Toggle Fullscreen" { fullscreen-window; }
    Mod+A repeat=false hotkey-overlay-title="Maximize Column" { maximize-column; }
    Mod+Shift+F repeat=false hotkey-overlay-title="Move Window to Floating" { move-window-to-floating; }
    Mod+Ctrl+F repeat=false hotkey-overlay-title="Move Window to Tiling" { move-window-to-tiling; }

    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-right; }
    Mod+Up { focus-window-up; }
    Mod+Down { focus-window-down; }

    // Move windows between Niri's horizontal columns and vertical stacks.
    Mod+BracketLeft repeat=false hotkey-overlay-title="Consume or Expel Window Left" { consume-or-expel-window-left; }
    Mod+BracketRight repeat=false hotkey-overlay-title="Consume or Expel Window Right" { consume-or-expel-window-right; }
    Mod+Comma repeat=false hotkey-overlay-title="Consume Window into Column" { consume-window-into-column; }
    Mod+Period repeat=false hotkey-overlay-title="Expel Window from Column" { expel-window-from-column; }

    // Show several windows in one column as vertical tabs.
    Mod+W repeat=false hotkey-overlay-title="Toggle Tabbed Column Display" { toggle-column-tabbed-display; }

    // Use the preset heights from layout.preset-window-heights.
    Mod+Shift+R repeat=false hotkey-overlay-title="Cycle Preset Column Width" { switch-preset-column-width; }
    Mod+Alt+R repeat=false hotkey-overlay-title="Cycle Preset Column Width Backward" { switch-preset-column-width-back; }
    Mod+Ctrl+Shift+R repeat=false hotkey-overlay-title="Cycle Preset Window Height" { switch-preset-window-height; }
    Mod+Ctrl+R repeat=false hotkey-overlay-title="Reset Window Height" { reset-window-height; }
    Mod+Shift+C repeat=false hotkey-overlay-title="Center Column" { center-column; }
    Mod+Shift+E repeat=false hotkey-overlay-title="Expand Column to Available Width" { expand-column-to-available-width; }

    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    MouseForward { focus-workspace-down; }
    MouseBack { focus-workspace-up; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+U { focus-workspace-down; }
    Mod+I { focus-workspace-up; }
    Mod+Ctrl+U { move-column-to-workspace-down; }
    Mod+Ctrl+I { move-column-to-workspace-up; }
    Mod+Shift+U { move-workspace-down; }
    Mod+Shift+I { move-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+Ctrl+H { move-column-left; }
    Mod+Ctrl+J { move-window-down; }
    Mod+Ctrl+K { move-window-up; }
    Mod+Ctrl+L { move-column-right; }
    Mod+Ctrl+Left { move-column-left; }
    Mod+Ctrl+Down { move-window-down; }
    Mod+Ctrl+Up { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }

    Mod+Alt+H { set-column-width "-10%"; }
    Mod+Alt+L { set-column-width "+10%"; }
    Mod+Alt+K { set-window-height "-10%"; }
    Mod+Alt+J { set-window-height "+10%"; }
    Mod+Alt+Left { set-column-width "-10%"; }
    Mod+Alt+Right { set-column-width "+10%"; }
    Mod+Alt+Up { set-window-height "-10%"; }
    Mod+Alt+Down { set-window-height "+10%"; }

    Mod+Shift+H { move-workspace-to-monitor-left; }
    Mod+Shift+J { move-workspace-to-monitor-down; }
    Mod+Shift+K { move-workspace-to-monitor-up; }
    Mod+Shift+L { move-workspace-to-monitor-right; }
    Mod+Shift+Left { move-workspace-to-monitor-left; }
    Mod+Shift+Down { move-workspace-to-monitor-down; }
    Mod+Shift+Up { move-workspace-to-monitor-up; }
    Mod+Shift+Right { move-workspace-to-monitor-right; }
    Mod+B { focus-monitor-next; }
    Mod+Shift+B { move-workspace-to-monitor-next; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    Mod+C repeat=false { spawn "@focusOrSpawn@" "^(zen-beta|app\\.zen_browser\\.zen)$" "zen-beta"; }
    Mod+Q repeat=false { spawn "@focusOrSpawn@" "^QQ$" "qq"; }
    Mod+0 repeat=false { spawn "@focusOrSpawn@" "^QQ$" "qq"; }
    Mod+N repeat=false { spawn "@focusOrSpawn@" "NeteaseCloudMusic" "netease-cloud-music-gtk4"; }
    Mod+O repeat=false { spawn "@focusOrSpawn@" "^obsidian$" "obsidian"; }
    Mod+D repeat=false { spawn "@focusOrSpawn@" "^obsidian$" "obsidian"; }
    Mod+X repeat=false { spawn "@focusOrSpawn@" "^dev\\.zed\\.Zed$" "zeditor"; }
    Mod+Z repeat=false { spawn "@focusOrSpawn@" "^zotero$" "zotero"; }
    Mod+V repeat=false { spawn "@focusOrSpawn@" "^code$" "code"; }
    Mod+Shift+O repeat=false hotkey-overlay-title="Toggle Overview" { toggle-overview; }

    Mod+Ctrl+C repeat=false { spawn-sh "@wlPaste@ --primary --no-newline | @wlCopy@"; }
    Mod+Ctrl+Shift+P repeat=false hotkey-overlay-title="Clipboard History" { spawn "@clipboardPicker@"; }

    Print repeat=false hotkey-overlay-title="Interactive Screenshot" { screenshot; }
    Mod+Shift+A repeat=false hotkey-overlay-title="Interactive Screenshot" { screenshot; }
    Ctrl+Print repeat=false hotkey-overlay-title="Screenshot Screen" { screenshot-screen; }
    Alt+Print repeat=false hotkey-overlay-title="Screenshot Window" { screenshot-window; }

    XF86Tools repeat=false { spawn "@wallpaperQuote@" "default"; }
    Shift+XF86Tools repeat=false { spawn "@wallpaperQuote@" "anime"; }
    Ctrl+XF86Tools repeat=false { spawn "@wpaperctl@" "next-wallpaper"; }
    Ctrl+Shift+XF86Tools repeat=false { spawn "@wallpaperQuote@" "alternate"; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "@mediaControl@" "volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "@mediaControl@" "volume-down"; }
    XF86AudioMute allow-when-locked=true { spawn "@mediaControl@" "volume-mute"; }
    XF86AudioMicMute allow-when-locked=true { spawn "@mediaControl@" "microphone-mute"; }
    XF86AudioNext allow-when-locked=true { spawn "@playerctl@" "next"; }
    XF86AudioPause allow-when-locked=true { spawn "@playerctl@" "play-pause"; }
    XF86AudioPlay allow-when-locked=true { spawn "@playerctl@" "play-pause"; }
    XF86AudioPrev allow-when-locked=true { spawn "@playerctl@" "previous"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "@brightnessctl@" "set" "10%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "@brightnessctl@" "set" "10%-"; }

    Mod+Escape repeat=false allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
}
