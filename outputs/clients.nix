{ ... }:
{
  perSystem =
    { pkgs, ... }:
    let
      lib = pkgs.lib;
      willow = import ../modules/profiles/programs/mihomo/willow.nix;

      # Nix cannot decrypt SOPS during a pure build. The caller supplies the
      # password from hosts/Willow/mihomo.secrets.yaml via --impure:
      #   WILLOW_SS_PASSWORD=... nix build --impure .#clash-verge-willow
      # The placeholder keeps `nix flake check` (pure) evaluable.
      password =
        let
          value = builtins.getEnv "WILLOW_SS_PASSWORD";
        in
        if value == "" then "<WILLOW_SS_PASSWORD>" else value;

      proxyLines = [
        "- name: ${willow.name}"
        "  type: ss"
        "  server: ${willow.server}"
        "  port: ${toString willow.port}"
        "  cipher: ${willow.cipher}"
        "  password: \"${password}\""
        "  udp: ${lib.boolToString willow.udp}"
      ];

      renderProxy = indent: lib.concatMapStringsSep "\n" (line: "${indent}${line}") proxyLines;

      ruleLines = lib.concatMapStringsSep "\n" (rule: "  - ${rule}") (willow.openaiRules willow.name);

      full = ''
        # Generated by the NixOS repository. Contains the Willow SS password.
        mixed-port: 7897
        allow-lan: false
        mode: rule
        log-level: info
        ipv6: false
        unified-delay: true
        tcp-concurrent: true

        profile:
          store-selected: true
          store-fake-ip: true

        dns:
          enable: true
          ipv6: false
          enhanced-mode: fake-ip
          fake-ip-range: 198.18.0.1/16
          respect-rules: true
          default-nameserver:
            - 223.5.5.5
            - 119.29.29.29
          nameserver:
            - https://1.1.1.1/dns-query
            - https://dns.google/dns-query
          proxy-server-nameserver:
            - https://1.1.1.1/dns-query
          nameserver-policy:
            "+.openai.com": [https://1.1.1.1/dns-query]
            "+.chatgpt.com": [https://1.1.1.1/dns-query]
            "+.oaistatic.com": [https://1.1.1.1/dns-query]
            "+.oaiusercontent.com": [https://1.1.1.1/dns-query]
            "+.oaistatsig.com": [https://1.1.1.1/dns-query]
            "+.intercom.io": [https://1.1.1.1/dns-query]
            "+.intercomcdn.com": [https://1.1.1.1/dns-query]
            "+.ct.sendgrid.net": [https://1.1.1.1/dns-query]
          fake-ip-filter:
            - "*.lan"
            - "*.local"
            - localhost
            - "time.*"
            - "stun.*"

        tun:
          enable: true
          stack: system
          auto-route: true
          auto-detect-interface: true
          dns-hijack:
            - any:53

        proxies:
        ${renderProxy "  "}

        proxy-groups:
          - name: Chain
            type: select
            proxies:
              - ${willow.name}
              - DIRECT

        rules:
          - DOMAIN-SUFFIX,lan,DIRECT
          - DOMAIN-SUFFIX,local,DIRECT
          - IP-CIDR,127.0.0.0/8,DIRECT,no-resolve
          - IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
          - IP-CIDR,172.16.0.0/12,DIRECT,no-resolve
          - IP-CIDR,192.168.0.0/16,DIRECT,no-resolve
          - IP-CIDR,100.64.0.0/10,DIRECT,no-resolve
          - IP-CIDR6,::1/128,DIRECT,no-resolve
          - IP-CIDR6,fc00::/7,DIRECT,no-resolve
          - IP-CIDR6,fe80::/10,DIRECT,no-resolve
          - MATCH,Chain
      '';

      merge = ''
        # Generated by the NixOS repository. Contains the Willow SS password.
        prepend-proxies:
        ${renderProxy "  "}

        prepend-rules:
        ${ruleLines}
      '';

      script = ''
        // Generated by the NixOS repository. Contains the Willow SS password.
        function main(config) {
          const willow = ${
            builtins.toJSON {
              name = willow.name;
              type = "ss";
              server = willow.server;
              port = willow.port;
              cipher = willow.cipher;
              password = password;
              udp = willow.udp;
            }
          };
          const rules = ${builtins.toJSON (willow.openaiRules willow.name)};
          config.proxies = [willow, ...(config.proxies || [])];
          config.rules = [...rules, ...(config.rules || [])];
          return config;
        }
      '';
    in
    {
      packages.clash-verge-willow = pkgs.runCommand "clash-verge-willow" { } ''
        mkdir -p $out
        cp ${pkgs.writeText "willow.yaml" full} $out/willow.yaml
        cp ${pkgs.writeText "willow-merge.yaml" merge} $out/willow-merge.yaml
        cp ${pkgs.writeText "willow-script.js" script} $out/willow-script.js
        cp ${../docs/clients/clash-verge/README.md} $out/README.md
      '';
    };
}
